---
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { t } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  noHeader?: boolean;
  noFooter?: boolean;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
}

const {
  title = t('site.title'),
  description = t('site.description'),
  canonicalUrl,
  noHeader = false,
  noFooter = false,
  ogType = 'website',
  publishedTime,
  modifiedTime,
} = Astro.props;

// canonicalUrl points a mirrored post at its original (TWiR), which is right
// for search indexing. og:url is a different thing - the identity of the share
// card - and must stay on our own page, or social engagement goes to the
// source site instead.
const pageURL = new URL(Astro.url.pathname, Astro.site);
const canonicalURL = canonicalUrl ? new URL(canonicalUrl) : pageURL;
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={pageURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="vremyavnikuda" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="vremyavnikuda — システムソフトウェア、Rust、Linux" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={t('site.title')}
      href="/rss.xml"
    />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-60 focus:rounded-lg focus:bg-primary-400 focus:px-4 focus:py-2 focus:text-slate-950"
    >
      コンテンツへスキップ
    </a>
    {!noHeader && <Header />}
    <main id="main" class="min-h-screen">
      <slot />
    </main>
    {!noFooter && <Footer />}
  </body>
</html>
