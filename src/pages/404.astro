---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="404 - vremyavnikuda" description="ページが見つかりませんでした">
  <div class="max-w-3xl mx-auto px-4 py-24">
    <h1 class="text-6xl font-bold mb-8">404</h1>
    <p class="text-xl text-(--color-text-secondary) mb-8">
      ページが見つかりませんでした。
    </p>
    <div class="flex flex-col sm:flex-row gap-4">
      <a
        href="/"
        class="px-6 py-3 bg-primary-400 text-slate-950 font-medium rounded-lg hover:bg-primary-300 transition-colors w-full sm:w-auto text-center"
      >
        ホーム
      </a>
    </div>
  </div>
</BaseLayout>
