---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { t } from '../i18n/ui';
import ProjectsRoadmapVisualization from '@components/ProjectsRoadmapVisualization';
import { buildProjectRoadmapNodes, sortProjectsForRoadmap } from '../lib/projectsData';

const projects = buildProjectRoadmapNodes(sortProjectsForRoadmap(await getCollection('projects')));
---

<BaseLayout title={`${t('projects.title')} - vremyavnikuda`} description={t('projects.description')}>
  <div class="w-full px-2 py-4">
    <h1 class="sr-only">{t('projects.title')}</h1>
    {projects.length === 0 ? (
      <p class="text-(--color-text-secondary)">{t('projects.noProjects')}</p>
    ) : (
      <ProjectsRoadmapVisualization projects={projects} detailsUrl="/projects-data/ja.json" client:load />
    )}
  </div>
</BaseLayout>
